<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Para Ilyancito ❤️</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;

    background:
        radial-gradient(circle at center, #123d70 0%, #071a35 35%, #020814 75%);

    color: white;
    font-family: Arial, sans-serif;
}

/* ESTRELLAS */

.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
}

.star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #9bd7ff;
    border-radius: 50%;
    animation: twinkle 2s infinite alternate;
}

.star:nth-child(1) { top: 8%; left: 12%; }
.star:nth-child(2) { top: 18%; left: 82%; animation-delay: .5s; }
.star:nth-child(3) { top: 32%; left: 7%; animation-delay: 1s; }
.star:nth-child(4) { top: 58%; left: 92%; animation-delay: .7s; }
.star:nth-child(5) { top: 75%; left: 18%; animation-delay: 1.3s; }
.star:nth-child(6) { top: 88%; left: 75%; animation-delay: .3s; }
.star:nth-child(7) { top: 14%; left: 50%; animation-delay: 1.5s; }
.star:nth-child(8) { top: 47%; left: 72%; animation-delay: .8s; }
.star:nth-child(9) { top: 70%; left: 48%; animation-delay: 1.1s; }
.star:nth-child(10) { top: 27%; left: 38%; animation-delay: .4s; }

@keyframes twinkle {

    from {
        opacity: .2;
        transform: scale(.6);
    }

    to {
        opacity: 1;
        transform: scale(1.5);
    }
}

/* CORAZONES */

.heart {
    position: fixed;
    bottom: -40px;
    pointer-events: none;
    z-index: 2;

    color: #7ecbff;
    font-size: 20px;

    animation: hearts 8s linear infinite;
}

.heart:nth-of-type(1) {
    left: 12%;
    animation-delay: 1s;
}

.heart:nth-of-type(2) {
    left: 35%;
    animation-delay: 4s;
}

.heart:nth-of-type(3) {
    left: 60%;
    animation-delay: 2s;
}

.heart:nth-of-type(4) {
    left: 82%;
    animation-delay: 5s;
}

@keyframes hearts {

    0% {
        transform: translateY(0) scale(.5) rotate(0deg);
        opacity: 0;
    }

    15% {
        opacity: .8;
    }

    100% {
        transform:
            translateY(-110vh)
            scale(1.2)
            rotate(25deg);

        opacity: 0;
    }
}

/* CONTENEDOR */

.container {
    position: relative;
    z-index: 3;

    width: 100%;
    max-width: 700px;

    margin: auto;

    padding:
        35px 20px 60px;

    text-align: center;
}

/* TITULO */

.small-title {
    color: #75c7ff;

    font-size: 13px;
    letter-spacing: 4px;

    text-transform: uppercase;

    margin-bottom: 12px;
}

h1 {
    font-size: 38px;
    margin: 0;

    text-shadow:
        0 0 15px #168cff,
        0 0 30px rgba(24,140,255,.5);
}

.subtitle {
    color: #a9c9e9;
    margin-top: 10px;
}

/* ZONA DEL DISCO */

.record-area {

    position: relative;

    width: 310px;
    height: 310px;

    margin:
        45px auto 30px;

    display: flex;

    justify-content: center;
    align-items: center;
}

/* LUZ */

.glow {

    position: absolute;

    width: 270px;
    height: 270px;

    border-radius: 50%;

    background: #168cff;

    filter: blur(55px);

    opacity: .3;

    animation: glow 2s infinite alternate;
}

@keyframes glow {

    from {
        transform: scale(.9);
        opacity: .2;
    }

    to {
        transform: scale(1.1);
        opacity: .45;
    }
}

/* DISCO */

.record {

    position: relative;

    width: 270px;
    height: 270px;

    border-radius: 50%;

    cursor: pointer;

    background:
        repeating-radial-gradient(
            circle,
            #010409 0px,
            #081321 2px,
            #010409 4px
        );

    box-shadow:

        0 0 12px #168cff,

        0 0 35px rgba(22,140,255,.5),

        inset 0 0 40px #000;

    animation:
        spin 7s linear infinite;

    transition: transform .3s;
}

/* REFLEJO */

.record::before {

    content: "";

    position: absolute;

    inset: 0;

    border-radius: 50%;

    background:
        linear-gradient(
            130deg,
            transparent 25%,
            rgba(120,210,255,.3) 48%,
            transparent 65%
        );
}

/* ANILLO EXTERIOR */

.record::after {

    content: "";

    position: absolute;

    inset: 10px;

    border-radius: 50%;

    border:
        1px solid rgba(120,200,255,.2);
}

@keyframes spin {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

/* CENTRO DEL DISCO */

.label {

    position: absolute;

    width: 110px;
    height: 110px;

    top: 80px;
    left: 80px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            #9bdcff 0%,
            #217ecb 35%,
            #07386b 75%
        );

    border:
        2px solid #a9e0ff;

    box-shadow:
        0 0 20px rgba(80,180,255,.7);

    display: flex;

    justify-content: center;
    align-items: center;

    text-align: center;
}

.label-text {

    font-size: 12px;

    font-weight: bold;

    line-height: 1.5;
}

/* CENTRO */

.hole {

    position: absolute;

    width: 12px;
    height: 12px;

    background: #020814;

    border-radius: 50%;

    top: 47px;
    left: 47px;
}

/* INDICACION */

.tap {

    margin-top: 5px;

    color: #8ccfff;

    font-size: 14px;

    animation: pulse 1.7s infinite;
}

@keyframes pulse {

    0%,100% {
        opacity: .45;
    }

    50% {
        opacity: 1;
    }
}

/* CANCION */

.song {

    margin-top: 25px;
}

.song-title {

    font-size: 26px;

    font-weight: bold;
}

.artist {

    margin-top: 5px;

    color: #72baff;
}

/* CARTA */

.card {

    margin-top: 45px;

    padding: 28px 25px;

    background:
        rgba(3,18,38,.85);

    border:
        1px solid rgba(80,170,240,.4);

    border-radius: 20px;

    box-shadow:
        0 0 35px rgba(0,120,255,.18);

    text-align: left;

    backdrop-filter: blur(8px);
}

.card h2 {

    text-align: center;

    color: #82ceff;

    margin-top: 0;
}

.letter {

    color: #d8eafb;

    font-size: 16px;

    line-height: 1.9;
}

.signature {

    text-align: center;

    margin-top: 25px;

    color: #82ceff;

    font-size: 18px;
}

/* FINAL */

.final {

    margin-top: 40px;

    color: #6686a8;

    font-size: 13px;
}

.final span {

    color: #75c7ff;
}

/* CELULAR */

@media(max-width:500px) {

    .container {
        padding-top: 28px;
    }

    h1 {
        font-size: 30px;
    }

    .record-area {

        width: 285px;
        height: 285px;
    }

    .record {

        width: 245px;
        height: 245px;
    }

    .label {

        width: 100px;
        height: 100px;

        top: 72px;
        left: 72px;
    }

    .hole {

        top: 43px;
        left: 43px;
    }

    .card {
        padding: 23px 20px;
    }

    .letter {
        font-size: 15px;
    }
}

</style>
</head>

<body>

<!-- ESTRELLAS -->

<div class="stars">

    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>

</div>

<!-- CORAZONES -->

<div class="heart">💙</div>
<div class="heart">♡</div>
<div class="heart">💙</div>
<div class="heart">♡</div>


<div class="container">

